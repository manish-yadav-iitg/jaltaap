# copy this file to .env and fill what you need. Everything is optional:
# with no AWS keys every AWS feature falls back to a free local path and the app still runs.

# ---------- AWS (run `aws configure`, or put keys here) ----------
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# set to off to force local fallbacks even when keys exist
JALTAAP_AWS=auto

# Amazon Bedrock: copilot answers, bulletins and the Strands agent
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
# auto = Bedrock when AWS keys exist, otherwise Ollama
JALTAAP_MODEL=auto

# created for you by `sam deploy` (see the EnvForLaptop output), or make them by hand
JALTAAP_DDB_TABLE=
JALTAAP_S3_BUCKET=
JALTAAP_SNS_TOPIC_ARN=
JALTAAP_PLACE_INDEX=
JALTAAP_ROUTE_CALCULATOR=
# optional: Amazon Location API key (geo-maps:GetTile) -> adds a satellite base map; streets use OpenStreetMap with no key
JALTAAP_MAPS_API_KEY=


# ---------- local LLM fallback ----------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---------- Telegram bot ----------
TELEGRAM_BOT_TOKEN=
# 1 = bot uses the AI agent, 0 = built-in English/Hindi templates
JALTAAP_USE_LLM=1
CHECK_EVERY_HOURS=6

# optional: Google Flood Hub second opinion (free, CC BY 4.0)
# join the waitlist: https://developers.google.com/flood-forecasting , then enable the API in Google Cloud
GOOGLE_FLOODHUB_API_KEY=
